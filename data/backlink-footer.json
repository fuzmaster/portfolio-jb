{
  "name": "jbd-backlink-footer",
  "version": "1.0.0",
  "description": "Portable, self-contained footer that links back to jacobbritten.com plus support links. Scoped class names (jbd-backlink-footer__*) and inline styling so it drops into any static site without depending on the host site's CSS.",
  "target": "https://jacobbritten.com",
  "markers": {
    "start": "<!-- JBD BACKLINK FOOTER START -->",
    "end": "<!-- JBD BACKLINK FOOTER END -->"
  },
  "links": [
    { "label": "Portfolio", "url": "https://jacobbritten.com", "external": true },
    { "label": "Projects", "url": "https://jacobbritten.com/projects.html", "external": true },
    { "label": "The Lab", "url": "https://jacobbritten.com/lab.html", "external": true },
    { "label": "Support", "url": "https://jacobbritten.com/support.html", "external": true },
    { "label": "Ko-fi", "url": "https://ko-fi.com/jacobbritten", "external": true },
    { "label": "PayPal", "url": "https://www.paypal.com/donate/?hosted_button_id=47A4JJ4WNBY9U", "external": true }
  ],
  "html": "<footer class=\"jbd-backlink-footer\">\n  <div class=\"jbd-backlink-footer__inner\">\n    <p class=\"jbd-backlink-footer__brand\">Built by <a href=\"https://jacobbritten.com\" target=\"_blank\" rel=\"noopener noreferrer\">Jacob Britten</a> &mdash; Media Systems Architect</p>\n    <nav class=\"jbd-backlink-footer__links\" aria-label=\"Jacob Britten\">\n      <a href=\"https://jacobbritten.com\" target=\"_blank\" rel=\"noopener noreferrer\">Portfolio</a>\n      <a href=\"https://jacobbritten.com/projects.html\" target=\"_blank\" rel=\"noopener noreferrer\">Projects</a>\n      <a href=\"https://jacobbritten.com/lab.html\" target=\"_blank\" rel=\"noopener noreferrer\">The Lab</a>\n      <a href=\"https://ko-fi.com/jacobbritten\" target=\"_blank\" rel=\"noopener noreferrer\">Ko-fi</a>\n      <a href=\"https://www.paypal.com/donate/?hosted_button_id=47A4JJ4WNBY9U\" target=\"_blank\" rel=\"noopener noreferrer\">PayPal</a>\n    </nav>\n  </div>\n</footer>",
  "css": ".jbd-backlink-footer{box-sizing:border-box;width:100%;background:#0B0D14;border-top:1px solid rgba(0,255,200,0.18);padding:1.5rem 1.25rem;font-family:'JetBrains Mono','SF Mono',Consolas,monospace}.jbd-backlink-footer *{box-sizing:border-box}.jbd-backlink-footer__inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:.6rem 1.5rem;flex-wrap:wrap}.jbd-backlink-footer__brand{margin:0;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.5)}.jbd-backlink-footer__brand a{color:#00FFC8;text-decoration:none}.jbd-backlink-footer__brand a:hover{text-decoration:underline}.jbd-backlink-footer__links{display:flex;gap:1.25rem;flex-wrap:wrap}.jbd-backlink-footer__links a{font-size:.68rem;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.72);text-decoration:none;transition:color .2s}.jbd-backlink-footer__links a:hover{color:#00FFC8}@media(max-width:560px){.jbd-backlink-footer__inner{flex-direction:column;align-items:flex-start}}",
  "embed": "<!-- JBD BACKLINK FOOTER START -->\n<style>.jbd-backlink-footer{box-sizing:border-box;width:100%;background:#0B0D14;border-top:1px solid rgba(0,255,200,0.18);padding:1.5rem 1.25rem;font-family:'JetBrains Mono','SF Mono',Consolas,monospace}.jbd-backlink-footer *{box-sizing:border-box}.jbd-backlink-footer__inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:.6rem 1.5rem;flex-wrap:wrap}.jbd-backlink-footer__brand{margin:0;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.5)}.jbd-backlink-footer__brand a{color:#00FFC8;text-decoration:none}.jbd-backlink-footer__brand a:hover{text-decoration:underline}.jbd-backlink-footer__links{display:flex;gap:1.25rem;flex-wrap:wrap}.jbd-backlink-footer__links a{font-size:.68rem;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.72);text-decoration:none;transition:color .2s}.jbd-backlink-footer__links a:hover{color:#00FFC8}@media(max-width:560px){.jbd-backlink-footer__inner{flex-direction:column;align-items:flex-start}}</style>\n<footer class=\"jbd-backlink-footer\">\n  <div class=\"jbd-backlink-footer__inner\">\n    <p class=\"jbd-backlink-footer__brand\">Built by <a href=\"https://jacobbritten.com\" target=\"_blank\" rel=\"noopener noreferrer\">Jacob Britten</a> &mdash; Media Systems Architect</p>\n    <nav class=\"jbd-backlink-footer__links\" aria-label=\"Jacob Britten\">\n      <a href=\"https://jacobbritten.com\" target=\"_blank\" rel=\"noopener noreferrer\">Portfolio</a>\n      <a href=\"https://jacobbritten.com/projects.html\" target=\"_blank\" rel=\"noopener noreferrer\">Projects</a>\n      <a href=\"https://jacobbritten.com/lab.html\" target=\"_blank\" rel=\"noopener noreferrer\">The Lab</a>\n      <a href=\"https://ko-fi.com/jacobbritten\" target=\"_blank\" rel=\"noopener noreferrer\">Ko-fi</a>\n      <a href=\"https://www.paypal.com/donate/?hosted_button_id=47A4JJ4WNBY9U\" target=\"_blank\" rel=\"noopener noreferrer\">PayPal</a>\n    </nav>\n  </div>\n</footer>\n<!-- JBD BACKLINK FOOTER END -->",
  "usage": {
    "quickStart": "Paste the value of the 'embed' field directly before </body> on any page of your other sites. It is fully self-contained (style + markup) and uses scoped class names, so it will not collide with the host site's CSS.",
    "separateFiles": "If you prefer separate CSS and HTML, drop the 'css' value into your stylesheet and the 'html' value into your page.",
    "font": "Falls back to system monospace if JetBrains Mono is not loaded. To match the portfolio exactly, add this in <head>: <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\">",
    "theme": "Dark by default (bg #0B0D14, accent #00FFC8). Change those two hex values in the css/embed strings to retheme."
  }
}
